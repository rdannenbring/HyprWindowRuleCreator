__pycache__/
*.pyc

# Timestamped config backups the app writes next to your rules file.
*.bak.*

# Local editor/agent state, not project config.
.claude/settings.local.json

# Python build artefacts.
build/
dist/
*.egg-info/

# makepkg working files. Scoped to packaging/ on purpose: an unanchored
# "hyprwrc/" would also ignore the Python package at the repo root.
packaging/src/
packaging/pkg/
packaging/hyprwrc/
packaging/*.pkg.tar.*
packaging/*.log
